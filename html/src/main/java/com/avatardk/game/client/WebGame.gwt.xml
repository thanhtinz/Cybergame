<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.11.0//EN" "http://www.gwtproject.org/doctype/2.11.0/gwt-module.dtd">
<!-- Module GWT của bản WEB: thừa hưởng code lõi, thay các phần không
     chạy trên trình duyệt bằng bản super-source trong thư mục super/
     (mạng TCP, nhạc YouTube/ffmpeg, tải dữ liệu, font FreeType). -->
<module rename-to="html">
    <inherits name="com.avatardk.game.AvatarGame"/>
    <entry-point class="com.avatardk.game.client.HtmlLauncher"/>
    <super-source path="super"/>
    <source path=""/>
    <set-property name="compiler.stackMode" value="emulated"/>
    <define-property name="avatardk.dataUrl" values="off,on"/>
    <set-property name="avatardk.dataUrl" value="off"/>
    <set-configuration-property name="gdx.assetpath" value="assets"/>
    <set-configuration-property name="gdx.assetoutputpath" value="build/web/"/>
</module>
